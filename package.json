{
  "name": "smart-inbox",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "npm run build && node scripts/cloudflare.mjs wrangler deploy",
    "seed:local": "node scripts/seed-local.mjs",
    "setup": "node scripts/setup.mjs",
    "release:check": "node scripts/export-source.mjs --check"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "agents": "^0.23.0",
    "ai": "^7.0.99",
    "hono": "^4.13.7",
    "htmlparser2": "^12.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.45.0",
    "postal-mime": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.17.7",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.1.1",
    "jsonc-parser": "^3.3.1",
    "miniflare": "^5.20260911.0-alpha",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
